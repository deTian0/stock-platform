# 本地环境模板（无密钥）。复制为 .env 后按需填写。

# --- 行情数据源预设（交易侧仍为 SIMULATE 纸面）---
# 未设置时生产默认 cn_astock_http（全 CN 走东财 em_get）
# cn_astock_http：全 CN 能力走东方财富 HTTP；易触发东财限流
# cn_tushare_http：日线走 Tushare 兼容 HTTP，其余 CN 仍用东财；适合 live 每日选股
# replay：本地 fixtures，零公网；仅 CI / 演示
# us_hk_global_http：美股/港股等全球行情
# STOCK_PLATFORM_PROVIDER_PRESET=cn_astock_http
# STOCK_PLATFORM_PROVIDER_PRESET=replay
# STOCK_PLATFORM_PROVIDER_PRESET=us_hk_global_http
# STOCK_PLATFORM_PROVIDER_PRESET=cn_tushare_http

# --- Tushare 兼容 HTTP（补充 CN 日线；切勿提交真实 Token）---
# STOCK_PLATFORM_TUSHARE_URL=https://t.xiaodefa.top/
# STOCK_PLATFORM_TUSHARE_TOKEN=your_token_here

# --- 持久化（U2 brief / U3 复盘等；现阶段 SQLite，日后可迁 PostgreSQL）---
# 勿把 *.db / *.sqlite 提交进 git；路径按本机调整即可
# STOCK_PLATFORM_DB_URL=sqlite:///./data/stock_platform.db

# --- Brief / 每日推荐回退：live 请保持注释（不要启用）---
# 当 live 东财日线失败且已配置 TOKEN 时，会自动回退 Tushare，无需再开本项。
# STOCK_PLATFORM_BRIEF_FALLBACK=replay 仅用于 CI/演示 fixtures，开启后是样例数据，
# 不是真实行情——勿静默当 live 用。
# STOCK_PLATFORM_BRIEF_FALLBACK=replay

# --- 日批 CLI 默认 provider（Invoke-DailyPipeline / stock-platform-daily；未传 -Provider 时）---
# 默认 replay 保 CI；日用可设 tushare（需 TOKEN，不静默降级 fixtures）
# STOCK_PLATFORM_DAILY_PROVIDER=replay
# STOCK_PLATFORM_DAILY_PROVIDER=tushare

# --- 推荐绩效 JSONL（生成 brief 后自动记入 pending；路径可改）---
# STOCK_PLATFORM_PERFORMANCE_LOG=./data/recommend_decisions.jsonl

# --- a-stock-engine 本地日线（只读；与 brief SQLite 分离）---
# 用途：pending 自动结算、Workbench「回测」滚动推荐复盘、预设 cn_engine_sqlite
# 路径：引擎仓 data_cache/market.db（约 2020–2026 全市场 daily_price），勿拷贝进本仓
# 未配置或文件不存在时：结算/回测 fail-closed 中文提示，不静默假数据
# 本机示例（按实际路径改）：
# STOCK_PLATFORM_ENGINE_MARKET_DB=D:/workspace/git/a-stock-engine/data_cache/market.db

# --- 策略 A/B 旁路（M-R5；默认关闭；不替换主路径 picks）---
# STOCK_PLATFORM_STRATEGY_AB=1
# STOCK_PLATFORM_STRATEGY_AB_A=lvrev-default-v1
# STOCK_PLATFORM_STRATEGY_AB_B=lvrev-rev-heavy-v1

# --- 可选更深 LLM 图（M-A4；默认关闭；另需 LLM_DEBATE + API key）---
# STOCK_PLATFORM_DEEP_LLM_GRAPH=1
# STOCK_PLATFORM_LLM_DEBATE=1
# STOCK_PLATFORM_LLM_API_KEY=

# --- 东财 HTTP 限流 / 重试 / 熔断（仅影响 eastmoney.com）---
# EM_MIN_INTERVAL=1.0
# EM_HTTP_RETRIES=3
# EM_HTTP_RETRY_BACKOFF=0.5
# EM_CIRCUIT_FAILURES=5
# EM_CIRCUIT_COOLDOWN=60
# STOCK_PLATFORM_HTTP_TRUST_ENV=0：默认忽略系统 HTTP_PROXY（避免坏代理）
# 仅在确实需要走代理时才设为 1
# STOCK_PLATFORM_HTTP_TRUST_ENV=0

# --- 券商 / 下单通道：纸面交易（默认 paper；永不实盘）---
# STOCK_PLATFORM_BROKER=paper
# STOCK_PLATFORM_BROKER=ths_sim
# STOCK_PLATFORM_THS_MODE=mock
# STOCK_PLATFORM_THS_MODE=experimental
# STOCK_PLATFORM_THS_BASE_URL=
# STOCK_PLATFORM_THS_TOKEN=
# STOCK_PLATFORM_THS_ACCOUNT=
# 诚实性：mock=内存/fixtures；experimental=扩展点非生产；真实券商 HTTP 见 M-E4 门禁（未立项）
# 详见 docs/ops/broker-port-honesty.md

<?xml version="1.0" encoding="UTF-16"?>
<!--
  Sample Windows Task Scheduler task for M40 daily pipeline (M42 ops pack).
  Default: replay fixtures; no secrets; liveTrading not enabled.

  Import (elevated PowerShell), after editing WorkingDirectory / paths:
    Register-ScheduledTask -Xml (Get-Content -Raw .\scripts\ops\stock-platform-daily.xml) `
      -TaskName "stock-platform-daily"

  Or: Task Scheduler GUI → Import Task → select this file.
  See docs/ops/scheduler.md.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Date>2026-09-14T00:00:00</Date>
    <Author>stock-platform</Author>
    <Description>Run stock-platform-daily on CN trading days via Invoke-DailyPipeline.ps1 (skip closed days).</Description>
    <URI>\stock-platform-daily</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-09-15T08:30:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <!-- Edit WorkingDirectory to your clone path before import.
           Prefer pwsh.exe when PowerShell 7+ is installed; else powershell.exe. -->
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File ".\scripts\ops\Invoke-DailyPipeline.ps1" -SkipRefresh</Arguments>
      <WorkingDirectory>D:\workspace\git\stock-platform</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
